{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$r": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host','seed','dur'])",
          "host": { ".validate": "newData.val() === (data.exists() ? data.val() : auth.uid)" },
          "end": { ".validate": "newData.isNumber() && !data.exists()" }
        },
        "slots": {
          ".read": "auth != null",
          "$i": {
            ".write": "auth != null && $i.matches(/^([0-9]|[12][0-9]|3[0-5])$/) && !data.exists() && newData.val() === auth.uid"
          }
        },
        "players": {
          ".read": "auth != null",
          "$u": {
            ".write": "auth != null && auth.uid === $u && newData.exists()",
            ".validate": "newData.hasChildren(['name','skin','errors','slot','status'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
            "skin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
            "slot": { ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : root.child('rooms/' + $r + '/slots/' + newData.val()).val() === auth.uid)" },
            "joined": { ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now" },
            "lc": { ".validate": "newData.val() === now" },
            "status": { ".validate": "(newData.val() === 'active' && data.val() !== 'kicked') || (newData.val() === 'kicked' && newData.parent().child('errors').val() === 5)" },
            "errors": { ".validate": "newData.isNumber() && newData.val() <= 5 && (data.exists() ? (newData.val() === data.val() || newData.val() === data.val() + 1) : newData.val() === 0)" }
          }
        },
        "pos": {
          ".read": "auth != null",
          "$u": {
            ".write": "auth != null && auth.uid === $u && (!newData.exists() || root.child('rooms/' + $r + '/players/' + $u + '/errors').val() < 5)",
            ".validate": "newData.hasChildren(['x','y'])"
          }
        },
        "claims": {
          ".read": "auth != null",
          "$b": {
            "$u": {
              ".write": "auth != null && auth.uid === $u && !data.exists() && newData.exists() && root.child('rooms/' + $r + '/players/' + $u + '/errors').val() < 5 && root.child('rooms/' + $r + '/meta/end').val() > now && newData.parent().parent().parent().child('players/' + $u + '/lc').val() === now && (!root.child('rooms/' + $r + '/players/' + $u + '/lc').exists() || root.child('rooms/' + $r + '/players/' + $u + '/lc').val() < now - 5000)",
              ".validate": "newData.val() === now && $b.matches(/^b([0-9]|[1-3][0-9]|4[0-2])$/)"
            }
          }
        }
      }
    }
  }
}
